<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<IsPackable Condition="'$(Configuration)'=='Release'">true</IsPackable>
		<RootNamespace>BD.Common8.SourceGenerator.Ipc</RootNamespace>
		<!--8.yy.1MMdd.1hhmm-->
		<Version>8.25.10606.11900</Version>
		<FileVersion>$(Version)</FileVersion>
		<AssemblyVersion>$(Version)</AssemblyVersion>
		<Description>进程间通信 (IPC) 客户端源生成器</Description>
	</PropertyGroup>

	<!-- 👇 基于 Attribute 生成的 Attribute 类型源码引用 -->
	<ItemGroup>
		<Compile Include="..\BD.Common8.Ipc\Attributes\*.cs">
			<LinkBase>_SourceReference\BD.Common8.Ipc\Attributes</LinkBase>
		</Compile>
		<Compile Include="..\BD.Common8.Ipc\Enums\IpcGeneratorType.cs">
			<LinkBase>_SourceReference\BD.Common8.Ipc\Enums</LinkBase>
		</Compile>
	</ItemGroup>

	<!-- 👇 引用 NuGet 包 -->
	<ItemGroup>
		<PackageReference Include="Costura.Fody">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<Import Project="$(MSBuildThisFileDirectory)..\SharedProject\SourceGenerator.props" />

</Project>
