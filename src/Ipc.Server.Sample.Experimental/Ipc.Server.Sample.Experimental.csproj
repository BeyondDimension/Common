<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net$(DotNet_Version)</TargetFramework>
		<RootNamespace>Ipc.Sample</RootNamespace>
		<InvariantGlobalization>true</InvariantGlobalization>
		<PublishAot>false</PublishAot>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="..\ProjectUtils.cs" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Ipc.Sample" />
	</ItemGroup>

	<!-- 👇 项目引用源生成器 -->
	<ItemGroup>
		<ProjectReference Include="$(Path_Submodule_Common)src\BD.Common8.SourceGenerator.Ipc.Server\BD.Common8.SourceGenerator.Ipc.Server.csproj">
