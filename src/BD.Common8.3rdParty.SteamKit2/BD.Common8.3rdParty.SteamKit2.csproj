<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net$(DotNet_Version);net8.0</TargetFrameworks>
		<RootNamespace>SteamKit2</RootNamespace>
		<SignAssembly>true</SignAssembly>
		<Description>.NET library that aims to interoperate with the Steam network.</Description>
		<PackageIcon>steamkit_logo_128.png</PackageIcon>
		<PackageReadmeFile>description.md</PackageReadmeFile>
		<PackageLicenseExpression>LGPL-2.1-only</PackageLicenseExpression>
		<PackageTags>steamkit;sk2;steam;valve;dota;dota2;csgo</PackageTags>
		<ProjectGuid>{4B2B0365-DE37-4B65-B614-3E4E7C05147D}</ProjectGuid>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="..\..\ref\huaweicloud-sdk-dotnet-obs\**\*.cs">
			<Exclude>bin\**;obj\**</Exclude>
		</Compile>
		<Compile Remove="..\..\ref\huaweicloud-sdk-dotnet-obs\bin\**\*.cs" />
		<Compile Remove="..\..\ref\huaweicloud-sdk-dotnet-obs\obj\**\*.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Win32.Registry" />
		<PackageReference Include="Microsoft.Windows.CsWin32">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="protobuf-net" />
		<PackageReference Include="System.IO.Hashing" />
	</ItemGroup>

</Project>
