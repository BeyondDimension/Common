<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<IsPackable Condition="'$(Configuration)'=='Release'">true</IsPackable>
		<TargetFrameworks>net$(DotNet_Version);net$(DotNet_Version)-windows;net8.0;net8.0-windows</TargetFrameworks>
		<RootNamespace>SteamKit2</RootNamespace>
		<AssemblyName>SteamKit2</AssemblyName>
		<PackageId>$(MSBuildProjectName)</PackageId>
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>..\..\ref\SteamKit\SteamKit.snk</AssemblyOriginatorKeyFile>
		<Description>.NET library that aims to interoperate with the Steam network.</Description>
		<PackageIcon>steamkit_logo_128.png</PackageIcon>
		<PackageReadmeFile>description.md</PackageReadmeFile>
		<PackageLicenseExpression>LGPL-2.1-only</PackageLicenseExpression>
		<PackageTags>steamkit;sk2;steam;valve;dota;dota2;csgo</PackageTags>
		<ProjectGuid>{4B2B0365-DE37-4B65-B614-3E4E7C05147D}</ProjectGuid>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<Choose>
		<When Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' OR $(TargetFramework.StartsWith('net4')) OR $(TargetFramework.StartsWith('netstandard'))">
			<PropertyGroup>
				<SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
				<TargetPlatformMinVersion>7.0</TargetPlatformMinVersion>
			</PropertyGroup>
		</When>
	</Choose>

	<!-- 👇 版本号值位于 Common\ref\SteamKit\Directory.Build.props -->
	<PropertyGroup>
		<!--o.o.o.yyMMi-->
		<SteamKitBaseVersion>3.0.0.25061</SteamKitBaseVersion>
		<SteamKitVersion Condition=" '$(GITHUB_RUN_NUMBER)' != ''">$(SteamKitBaseVersion)-Alpha.$(GITHUB_RUN_NUMBER)</SteamKitVersion>
		<SteamKitVersion Condition=" '$(GITHUB_RUN_NUMBER)' == ''">$(SteamKitBaseVersion)</SteamKitVersion>
		<AssemblyVersion>$(SteamKitBaseVersion)</AssemblyVersion>
		<FileVersion>$(SteamKitBaseVersion)</FileVersion>
		<Version>$(SteamKitVersion)</Version>
	</PropertyGroup>

	<!-- 👇 在 Common\ref\SteamKit\SteamKit2\SteamKit2\Properties\AssemblyInfo.cs 中已声明部分 attr，所以关闭 msbuild 的生成 -->
	<PropertyGroup>
		<GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
		<GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
		<GenerateAssemblyCopyrightAttribute>false</GenerateAssemblyCopyrightAttribute>
		<GenerateAssemblyDescriptionAttribute>false</GenerateAssemblyDescriptionAttribute>
		<GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
		<GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
		<GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
	</PropertyGroup>

	<!-- 👇 将无-后缀的 TFM 视作 Linux 平台，设置 DefineConstants -->
	<PropertyGroup>
		<DefineConstants Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == ''">LINUX;$(DefineConstants)</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="..\..\ref\SteamKit\SteamKit2\SteamKit2\**\*.cs">
			<Exclude>bin\**;obj\**</Exclude>
		</Compile>
		<Compile Remove="..\..\ref\SteamKit\SteamKit2\SteamKit2\bin\**\*.cs" />
		<Compile Remove="..\..\ref\SteamKit\SteamKit2\SteamKit2\obj\**\*.cs" />
		<None Include="..\..\ref\SteamKit\SteamKit2\SteamKit2\3rd party.txt">
			<Pack>true</Pack>
			<PackagePath />
		</None>
		<None Include="..\..\ref\SteamKit\SteamKit2\SteamKit2\changes.txt">
			<Pack>true</Pack>
			<PackagePath>readme.txt</PackagePath>
		</None>
		<None Include="..\..\ref\SteamKit\SteamKit2\SteamKit2\license.txt">
			<Pack>true</Pack>
			<PackagePath />
		</None>
		<None Include="..\..\ref\SteamKit\Resources\Misc\steamkit_logo_128.png" Pack="true" PackagePath="\" />
		<None Include="..\..\ref\SteamKit\Resources\Misc\package_readme.md" Pack="true" PackagePath="\description.md" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="..\InternalsVisibleTo.BD.Common8.UnitTest.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'" Include="Microsoft.Win32.Registry" />
		<PackageReference Include="Microsoft.Windows.CsWin32">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<AdditionalFiles Include="..\..\ref\SteamKit\SteamKit2\SteamKit2\NativeMethods.txt" />
		<PackageReference Include="protobuf-net" />
		<PackageReference Include="System.IO.Hashing" />
	</ItemGroup>

</Project>
